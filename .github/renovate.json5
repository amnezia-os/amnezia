{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  "packageRules": [
    {
      "autoupdate": true,
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    // Amnezia OS deliberately follows floating tags: the base image tracks
    // Fedora 44 and the NVIDIA modules track the daily akmods rebuilds.
    // Pinning them to a digest would defeat that, so leave them alone.
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/ublue-os/kinoite-main",
        "ghcr.io/ublue-os/akmods-nvidia-open"
      ],
      "enabled": false
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ]
}
