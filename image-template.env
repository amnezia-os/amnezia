# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=amnezia

# Make this the same as your github username/organisation
REPO_ORGANIZATION="amnezia-os"

IMAGE_DESC="Amnezia OS - a Fedora 44 Kinoite based, atomic and immutable desktop"
IMAGE_KEYWORDS="bootc,oci,linux,kinoite,fedora,atomic,immutable,kde"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://raw.githubusercontent.com/amnezia-os/amnezia/main/branding/Amnezia_LOGO.png"
DEFAULT_TAG="44"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
